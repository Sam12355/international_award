# Server
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sjp_dev
JWT_SECRET=your-jwt-secret-change-me
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP (use Ethereal for dev: https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SJP Platform <noreply@sjp.dev>"

# CrossRef API
CROSSREF_DEPOSIT_URL=https://doi.crossref.org/servlet/deposit
CROSSREF_USERNAME=
CROSSREF_PASSWORD=

# Google Scholar Indexing
SCHOLAR_API_URL=https://scholar.google.com/scholar/api/submit
SCHOLAR_API_KEY=

# Client
CLIENT_URL=http://localhost:5173
SERVER_PORT=3001

# Client-side (VITE_ prefix required)
VITE_API_URL=http://localhost:3001/api
