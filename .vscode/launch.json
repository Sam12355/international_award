{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/var/www/html": "${workspaceFolder}/Laravel"
            },
            "hostname": "0.0.0.0",
            "log": true
        },
        {
            "name": "Launch Built-in Server (Xdebug)",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-dxdebug.mode=debug",
                "-dxdebug.start_with_request=yes",
                "-dxdebug.client_port=9003",
                "-S", "localhost:8000",
                "-t", "${workspaceFolder}/Laravel/public"
            ],
            "program": "",
            "cwd": "${workspaceFolder}/Laravel",
            "port": 9003,
            "serverReadyAction": {
                "pattern": "Development Server .+ started",
                "uriFormat": "http://localhost:8000",
                "action": "openExternally"
            }
        },
        {
            "name": "Run PHPUnit Test (Xdebug)",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/Laravel/vendor/bin/phpunit",
            "args": [
                "--configuration",
                "${workspaceFolder}/Laravel/phpunit.xml",
                "${file}"
            ],
            "cwd": "${workspaceFolder}/Laravel",
            "port": 9003,
            "runtimeArgs": [
                "-dxdebug.mode=debug",
                "-dxdebug.start_with_request=yes"
            ]
        }
    ]
}
